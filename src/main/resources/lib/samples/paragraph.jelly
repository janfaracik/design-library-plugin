<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define">
  <st:documentation>
    Displays a paragraph.
  </st:documentation>

  <j:choose>
    <j:when test="${true}">
      <d:invokeBody />
    </j:when>
    <j:otherwise>
      <div class="jdl-paragraph">
        <d:invokeBody />
      </div>
    </j:otherwise>
  </j:choose>
</j:jelly>
